rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.systemRoles.hasAny(['ADMIN']);
    }

    function isSubjectMember(subjectId) {
      return signedIn()
        && exists(/databases/$(database)/documents/deliverySubjects/$(subjectId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/deliverySubjects/$(subjectId)/members/$(request.auth.uid)).data.active == true;
    }

    // Browsers read only subjects they belong to (or admins). Authoritative
    // writes go through Cloud Run application services using Admin SDK.
    match /deliverySubjects/{subjectId} {
      allow read: if isAdmin() || isSubjectMember(subjectId);
      allow write: if false;

      match /{subcollection}/{documentId} {
        allow read: if isAdmin() || isSubjectMember(subjectId);
        allow write: if false;
      }
    }

    // Shared reference/configuration data. Browser clients may read; all
    // publishing/promotion writes remain backend-only.
    match /requirementProfiles/{profileId} {
      allow read: if signedIn();
      allow write: if false;

      match /versions/{versionId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /requirementCatalog/{requirementId} {
      allow read: if signedIn();
      allow write: if false;

      match /versions/{versionId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // Profiles are readable to signed-in PoC users for names/expertise labels.
    // My Work uses a private per-user server-maintained projection rather than
    // a cross-subject task collection-group query, preserving subject isolation.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if false;

      match /taskInbox/{itemId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }
    }

    match /roleTemplates/{roleTemplateId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /perspectiveTemplates/{perspectiveTemplateId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
