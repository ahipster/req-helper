rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.systemRoles.hasAny(['ADMIN']);
    }

    function isSubjectMember(subjectId) {
      return signedIn()
        && exists(/databases/$(database)/documents/deliverySubjects/$(subjectId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/deliverySubjects/$(subjectId)/members/$(request.auth.uid)).data.active == true;
    }

    // Browsers read only subjects they belong to (or admins). Authoritative
    // writes go through Cloud Run application services using Admin SDK.
    match /deliverySubjects/{subjectId} {
      allow read: if isAdmin() || isSubjectMember(subjectId);
      allow write: if false;

      match /members/{memberId} {
        allow read: if isAdmin() || isSubjectMember(subjectId);
        allow write: if false;
      }

      match /tasks/{taskId} {
        allow read: if isAdmin() || isSubjectMember(subjectId);
        allow write: if false;
      }

      match /{subcollection}/{documentId} {
        allow read: if isAdmin() || isSubjectMember(subjectId);
        allow write: if false;
      }
    }

    // Collection-group My Work queries need an explicit recursive rule. Each
    // Task carries deliverySubjectId, which is checked against membership.
    match /{path=**}/tasks/{taskId} {
      allow read: if isAdmin()
        || (resource.data.deliverySubjectId is string
          && isSubjectMember(resource.data.deliverySubjectId));
      allow write: if false;
    }

    // PoC profiles are readable to signed-in users so names/expertise can be
    // shown in assignment pickers. Profile mutation remains backend-only.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /roleTemplates/{roleTemplateId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /perspectiveTemplates/{perspectiveTemplateId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
