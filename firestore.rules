rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // PoC baseline: browsers may subscribe/read authenticated collaboration
    // state, but authoritative domain mutations go through the Cloud Run API
    // using the Firebase Admin SDK. Admin SDK requests bypass these rules.
    match /deliverySubjects/{subjectId} {
      allow read: if signedIn();
      allow write: if false;

      match /{subcollection}/{documentId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // My Work uses a collection-group query over task subcollections across
    // Delivery Subjects. Keep browser access read-only.
    match /{path=**}/tasks/{taskId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
