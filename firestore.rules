rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.systemRoles.hasAny(['ADMIN']);
    }

    function isSubjectMember(subjectId) {
      return signedIn()
        && exists(/databases/$(database)/documents/deliverySubjects/$(subjectId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/deliverySubjects/$(subjectId)/members/$(request.auth.uid)).data.active == true;
    }

    function isBackendFilteredSubjectCollection(subcollection) {
      return subcollection == 'architectureContext'
        || subcollection == 'architectureImpacts'
        || subcollection == 'architectureImpactAssessments'
        || subcollection == 'architectureChangeProposals'
        || subcollection == 'workPackageImplementationTargets'
        || subcollection == 'handoffPackages';
    }

    match /deliverySubjects/{subjectId} {
      allow read: if isAdmin() || isSubjectMember(subjectId);
      allow write: if false;

      // Most collaborative subject state is safe for members. Architecture
      // slices and immutable handoff packages may inherit stricter source
      // permissions, so browsers must obtain them through backend APIs that
      // apply SourceAccessPolicy before serialization.
      match /{subcollection}/{documentId} {
        allow read: if !isBackendFilteredSubjectCollection(subcollection)
          && (isAdmin() || isSubjectMember(subjectId));
        allow write: if false;
      }

      match /architectureContext/{documentId} {
        allow read, write: if false;
      }
      match /architectureImpacts/{documentId} {
        allow read, write: if false;
      }
      match /architectureImpactAssessments/{documentId} {
        allow read, write: if false;
      }
      match /architectureChangeProposals/{documentId} {
        allow read, write: if false;
      }
      match /workPackageImplementationTargets/{documentId} {
        allow read, write: if false;
      }
      match /handoffPackages/{documentId} {
        allow read, write: if false;
      }
    }

    match /requirementProfiles/{profileId} {
      allow read: if signedIn();
      allow write: if false;

      match /versions/{versionId} {
        allow read: if signedIn();
        allow write: if false;

        match /architecturePolicies/{policyId} {
          allow read: if signedIn();
          allow write: if false;
        }
      }
    }

    match /requirementCatalog/{requirementId} {
      allow read: if signedIn();
      allow write: if false;

      match /versions/{versionId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // Source access/classification metadata is privileged configuration. App
    // ADMIN does not imply entitlement to the source content itself; backend
    // authorization still evaluates the policy against the caller audiences.
    match /sourceAccessPolicies/{policyId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Raw normalized architecture can contain information inherited from
    // restricted source repositories. Do not expose it directly to browsers.
    // Backend APIs return only caller-authorized filtered projections.
    match /architectureSources/{sourceId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /architectureBaselines/{baselineId} {
      allow read: if isAdmin();
      allow write: if false;

      match /{subcollection}/{documentId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /architectureIngestionRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if false;

      match /taskInbox/{itemId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }
    }

    match /roleTemplates/{roleTemplateId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /perspectiveTemplates/{perspectiveTemplateId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
