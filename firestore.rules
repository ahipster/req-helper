rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.systemRoles.hasAny(['ADMIN']);
    }

    function isSubjectMember(subjectId) {
      return signedIn()
        && exists(/databases/$(database)/documents/deliverySubjects/$(subjectId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/deliverySubjects/$(subjectId)/members/$(request.auth.uid)).data.active == true;
    }

    match /deliverySubjects/{subjectId} {
      allow read: if isAdmin() || isSubjectMember(subjectId);
      allow write: if false;

      match /{subcollection}/{documentId} {
        allow read: if isAdmin() || isSubjectMember(subjectId);
        allow write: if false;
      }
    }

    match /requirementProfiles/{profileId} {
      allow read: if signedIn();
      allow write: if false;

      match /versions/{versionId} {
        allow read: if signedIn();
        allow write: if false;

        match /architecturePolicies/{policyId} {
          allow read: if signedIn();
          allow write: if false;
        }
      }
    }

    match /requirementCatalog/{requirementId} {
      allow read: if signedIn();
      allow write: if false;

      match /versions/{versionId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // P0 architecture truth is a normalized, immutable derived baseline from
    // approved Git Markdown repositories. Source credentials never live here.
    match /architectureSources/{sourceId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /architectureBaselines/{baselineId} {
      allow read: if signedIn();
      allow write: if false;

      match /elements/{elementId} {
        allow read: if signedIn();
        allow write: if false;
      }

      match /relationships/{relationshipId} {
        allow read: if signedIn();
        allow write: if false;
      }

      match /views/{viewId} {
        allow read: if signedIn();
        allow write: if false;
      }

      // Ingestion diagnostics are an admin/steward workflow, not general
      // architecture reference data.
      match /ingestionFindings/{findingId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /architectureIngestionRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if false;

      match /taskInbox/{itemId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }
    }

    match /roleTemplates/{roleTemplateId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /perspectiveTemplates/{perspectiveTemplateId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
